<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification-area (tray) icon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WatchPointer</AssemblyName>
    <RootNamespace>WatchPointer.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WatchPointer.ico</ApplicationIcon>
    <AssemblyTitle>WatchPointer</AssemblyTitle>
    <!-- WPF Fluent theme (ThemeMode) is marked experimental. -->
    <!-- WFO0003: the DPI mode is set in app.manifest on purpose, because it's a WPF app (WinForms is only the tray icon). -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WatchPointer.Platform\WatchPointer.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Regenerate with tools/make-icon.ps1. Used for the exe, the window and the tray. -->
    <Resource Include="Assets\WatchPointer.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Avoid clashes between WinForms and WPF type names in implicit usings. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>
</Project>
