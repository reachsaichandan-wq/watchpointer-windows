<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:WatchPointer.App.ViewModels">
    <DataTemplate DataType="{x:Type vm:CalibrationViewModel}">
        <ScrollViewer Style="{StaticResource Page}">
            <StackPanel MaxWidth="980">
                <TextBlock Text="Calibration" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Recenter makes the current aim the middle of the screen. Full calibration measures how far you turn to reach the edges and sets the horizontal and vertical speed to match. Each step counts down 3 s, then averages 1 s of samples, so you never need to touch the PC while pointing." />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Quick recenter" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="Point at the middle of the screen, then press Recenter here, tap Center on the watch, or press the Recenter hotkey (Ctrl+Alt+C)." TextWrapping="Wrap" Margin="0,0,0,10" />
                        <Button Content="Recenter now" Command="{Binding RecenterNowCommand}" HorizontalAlignment="Left" Padding="14,8" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Guided calibration" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="{Binding Instruction}" TextWrapping="Wrap" FontSize="15" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding Countdown}" FontSize="40" FontWeight="SemiBold" Margin="0,0,0,10"
                                       Visibility="{Binding Busy, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Visibility="{Binding Step, Converter={StaticResource StepVisibility}, ConverterParameter='4'}" />
                            <WrapPanel>
                                <Button Content="Start calibration" Command="{Binding StartCommand}" Padding="14,8" Margin="0,0,8,0"
                                        IsEnabled="{Binding Busy, Converter={StaticResource InverseBool}}" />
                                <Button Content="Apply" Command="{Binding ApplyCommand}" Padding="14,8" Margin="0,0,8,0" IsEnabled="{Binding CanApply}" />
                                <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="14,8" IsEnabled="{Binding Busy}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding LiveAim}" Style="{StaticResource Caption}" Margin="0,12,0,0" />
                        </StackPanel>
                        <!-- Where to point -->
                        <StackPanel Grid.Column="1" Margin="24,0,0,0">
                            <TextBlock Text="Point here" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                            <Border Width="240" Height="135" CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <Canvas>
                                    <Ellipse Width="18" Height="18" Stroke="#FF463C" StrokeThickness="3"
                                             Canvas.Left="{Binding TargetX, Converter={StaticResource FractionToOffset}, ConverterParameter='240,18'}"
                                             Canvas.Top="{Binding TargetY, Converter={StaticResource FractionToOffset}, ConverterParameter='135,18'}" />
                                </Canvas>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Tips" Style="{StaticResource SectionHeader}" />
                        <TextBlock TextWrapping="Wrap" LineHeight="22">
                            <Run Text="• Hold the watch like a remote, 12 o'clock edge toward the screen, display facing up." /><LineBreak />
                            <Run Text="• Up/down comes from gravity and never drifts. Left/right integrates the gyroscope and can drift slowly; Recenter (or edge re-anchoring) fixes it." /><LineBreak />
                            <Run Text="• On the iPhone Watch app, turn off Passcode › Wrist Detection, or the watch locks when you take it off your wrist." /><LineBreak />
                            <Run Text="• On the watch, set Display &amp; Brightness › Wake Duration to 70 s and General › Return to Clock › WatchPointer to 1 hour." />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
