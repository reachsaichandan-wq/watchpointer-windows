<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:WatchPointer.App.ViewModels">
    <DataTemplate DataType="{x:Type vm:PairingViewModel}">
        <ScrollViewer Style="{StaticResource Page}">
            <StackPanel MaxWidth="980">
                <TextBlock Text="Device pairing" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="There is no Windows pairing step: this PC advertises a Bluetooth LE service, and you pick it on the watch. The watch then only connects to this PC until you choose Forget on the watch." />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Style="{StaticResource StatusDot}" Width="12" Height="12" Fill="{Binding VerdictTone, Converter={StaticResource ToneToBrush}}" />
                            <TextBlock Text="Bluetooth adapter" Style="{StaticResource SectionHeader}" Margin="0" />
                        </StackPanel>
                        <TextBlock Text="{Binding Verdict}" TextWrapping="Wrap" Margin="0,0,0,12" FontSize="14" />
                        <ItemsControl ItemsSource="{Binding Capabilities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="240" />
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding Tone, Converter={StaticResource ToneToBrush}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Value}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding Note}" Style="{StaticResource Caption}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding ReceiverState, StringFormat='Receiver: {0}'}" Style="{StaticResource Caption}" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding ProtocolInfo}" Style="{StaticResource Caption}" Margin="0,2,0,8" />
                        <WrapPanel>
                            <Button Content="Re-check adapter and restart" Command="{Binding RestartCommand}" Padding="14,8" Margin="0,0,8,0" />
                            <CheckBox Content="Start the receiver when WatchPointer starts" IsChecked="{Binding AutoStart}" VerticalAlignment="Center" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Pair the watch" Style="{StaticResource SectionHeader}" />
                        <TextBlock TextWrapping="Wrap" LineHeight="22">
                            <Run Text="1. Make sure the receiver says Advertising (top of the window)." /><LineBreak />
                            <Run Text="2. Open WatchPointer on the Apple Watch. Nearby PCs running the receiver are listed." /><LineBreak />
                            <Run Text="3. Tap Pair next to " /><Run Text="{Binding PcName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" (an unnamed entry may show as 'Windows PC' until the first connection)." /><LineBreak />
                            <Run Text="4. Point at the middle of the screen and tap Center on the watch." />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Connected watch" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{Binding WatchName}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding WatchDetail}" Style="{StaticResource Caption}" Margin="0,2,0,6" />
                        <TextBlock Text="{Binding ConnectionParameters, StringFormat='Connection: {0}'}" Style="{StaticResource Caption}" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding TrustedWatch, StringFormat='Trusted watch: {0}'}" Margin="0,0,0,6" />
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="Trust this watch" Command="{Binding TrustWatchCommand}" IsEnabled="{Binding WatchConnected}" Padding="14,8" Margin="0,0,8,0" />
                            <Button Content="Forget trusted watch" Command="{Binding ForgetTrustedCommand}" Padding="14,8" />
                        </WrapPanel>
                        <CheckBox Content="Only accept input from the trusted watch" IsChecked="{Binding OnlyTrusted}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="28,2,0,10"
                                   Text="Matches the name the watch reports. It stops other people's WatchPointer watches, but it is not authentication: a malicious device can claim any name." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Link options" Style="{StaticResource SectionHeader}" />
                        <CheckBox Content="Request a low-latency connection after the watch connects" IsChecked="{Binding RequestLowLatency}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="28,2,0,10" Text="Uses the Windows 11 22H2+ connection-parameter API. The watch decides; the result is logged." />
                        <CheckBox Content="Measure round-trip latency (protocol v2 watch app)" IsChecked="{Binding LatencyProbe}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="28,2,0,10" Text="Sends a 3-byte ping every 2 s. The original watch app never receives pings." />
                        <CheckBox Content="Require an encrypted (bonded) link — experimental" IsChecked="{Binding RequireEncryption}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="28,2,0,0" Text="Forces OS-level Bluetooth pairing between the watch and Windows before writes are accepted. Not verified on every adapter; turn it off if the watch can't connect. Applies after 'Restart'." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
