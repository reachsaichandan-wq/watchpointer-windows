<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:WatchPointer.App.ViewModels">
    <DataTemplate DataType="{x:Type vm:ShortcutsViewModel}">
        <ScrollViewer Style="{StaticResource Page}">
            <StackPanel MaxWidth="980">
                <TextBlock Text="Keyboard shortcuts" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Global hotkeys on this PC, and the shortcut syntax used by gesture mappings." Style="{StaticResource PageSubtitle}" />

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="3" Text="Global hotkeys" Style="{StaticResource SectionHeader}" />
                        <CheckBox Grid.Row="1" Grid.ColumnSpan="3" Content="Enable global hotkeys" IsChecked="{Binding Enabled}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="2" Text="Pause / resume pointer" Style="{StaticResource SettingLabel}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TogglePause}" Margin="0,4" />
                        <TextBlock Grid.Row="3" Text="Recenter" Style="{StaticResource SettingLabel}" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Recenter}" Margin="0,4" />
                        <TextBlock Grid.Row="4" Text="Laser dot" Style="{StaticResource SettingLabel}" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ToggleLaser}" Margin="0,4" />
                        <TextBlock Grid.Row="5" Text="Next profile" Style="{StaticResource SettingLabel}" />
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding NextProfile}" Margin="0,4" />
                        <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Margin="0,10,0,0">
                            <Button Content="Save hotkeys" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Padding="14,8" />
                            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Shortcut syntax" Style="{StaticResource SectionHeader}" />
                        <ItemsControl ItemsSource="{Binding Reference}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="380" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Example}" FontFamily="Cascadia Mono, Consolas" />
                                        <TextBlock Grid.Column="1" Text="{Binding Meaning}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Limitations}" Style="{StaticResource Caption}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Try a shortcut" Style="{StaticResource SectionHeader}" />
                        <WrapPanel>
                            <TextBox Text="{Binding TestMacro, UpdateSourceTrigger=PropertyChanged}" MinWidth="320" Margin="0,0,8,0" FontFamily="Cascadia Mono, Consolas" />
                            <Button Content="Send in 3 seconds" Command="{Binding TestCommand}" Padding="14,8" />
                        </WrapPanel>
                        <TextBlock Text="{Binding TestResult}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
