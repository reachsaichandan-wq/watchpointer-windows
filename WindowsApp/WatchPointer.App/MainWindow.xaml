<Window x:Class="WatchPointer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WatchPointer.App.ViewModels"
        Title="WatchPointer" Width="1100" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <DockPanel Grid.Column="0" Margin="8,12,4,12" LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,4,0,18">
                <Grid Width="28" Height="28" Margin="0,0,10,0">
                    <Ellipse Fill="#1C1C20" />
                    <Ellipse Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="2.5" Margin="2" />
                    <Ellipse Fill="#FF463C" Width="8" Height="8" />
                </Grid>
                <TextBlock Text="WatchPointer" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Theme picker at the bottom of the sidebar -->
            <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,0">
                <TextBlock Text="Theme" Style="{StaticResource Caption}" Margin="0,0,0,4" />
                <ComboBox x:Name="ThemePicker" SelectionChanged="OnThemeChanged">
                    <ComboBoxItem Content="System" />
                    <ComboBoxItem Content="Light" />
                    <ComboBoxItem Content="Dark" />
                </ComboBox>
                <CheckBox x:Name="TrayCheck" Content="Close to notification area" Margin="0,10,0,0" Click="OnTrayChanged" />
                <CheckBox x:Name="StartMinimizedCheck" Content="Start in notification area" Margin="0,6,0,0" Click="OnTrayChanged" />
            </StackPanel>

            <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PageViewModel}">
                        <StackPanel Orientation="Horizontal" Margin="4,6">
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16" Width="28" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Status strip + page content -->
        <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}" CornerRadius="8,0,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="32,10" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" DataContext="{Binding Dashboard}">
                        <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding WatchTone, Converter={StaticResource ToneToBrush}}" />
                        <TextBlock Text="{Binding WatchStatus}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="  ·  " VerticalAlignment="Center" Style="{StaticResource Caption}" />
                        <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding BluetoothTone, Converter={StaticResource ToneToBrush}}" />
                        <TextBlock Text="{Binding BluetoothStatus}" VerticalAlignment="Center" />
                        <TextBlock Text="  ·  " VerticalAlignment="Center" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding SelectedProfile}" VerticalAlignment="Center" />
                        <TextBlock Text="  ·  paused" VerticalAlignment="Center" Foreground="#D88C00"
                                   Visibility="{Binding Paused, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
                <ContentControl Content="{Binding SelectedPage}" Focusable="False" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
