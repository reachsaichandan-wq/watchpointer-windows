<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Version: overridden by the release workflow from the git tag (v1.2.3 → 1.2.3). -->
    <Version>1.1.0</Version>

    <!-- Author / copyright: shown in the exe's Properties › Details, the About page and the window. -->
    <Authors>sandareddysaichandan</Authors>
    <Company>sandareddysaichandan</Company>
    <Product>WatchPointer for Windows</Product>
    <Copyright>Copyright © 2026 sandareddysaichandan. MIT License.</Copyright>
    <Description>Use an Apple Watch as an air mouse for Windows over Bluetooth LE.</Description>
    <NeutralLanguage>en</NeutralLanguage>
    <RepositoryUrl>https://github.com/reachsaichandan-wq/watchpointer-windows</RepositoryUrl>
    <PackageProjectUrl>https://github.com/reachsaichandan-wq/watchpointer-windows</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
</Project>
