<Project Sdk="Microsoft.NET.Sdk">
  <!-- Command-line companion: adapter check, headless receiver, simulator and benchmark. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AssemblyName>watchpointer-cli</AssemblyName>
    <RootNamespace>WatchPointer.Tool</RootNamespace>
    <ApplicationIcon>..\WatchPointer.App\Assets\WatchPointer.ico</ApplicationIcon>
    <AssemblyTitle>WatchPointer command-line tool</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WatchPointer.Platform\WatchPointer.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
  </ItemGroup>
</Project>
